# Portfolio (Next.js) build-time settings — copy to .env.local for local overrides. Never put real secrets in this file:
# NEXT_PUBLIC_* values are compiled into the public site. Real values go in .env.local (git-ignored) or
# Vercel -> Project Settings -> Environment Variables.

# WebSocket URL of the RC Crawler multiplayer server (multiplayer-server/). Production must be wss://.
# Leave unset locally: the game finds a dev server on ws://localhost:2567 by itself.
NEXT_PUBLIC_RC_MULTIPLAYER_URL=

# --- Admin content editor (/admin) --------------------------------------------------------------
# Without these the site shows its built-in content and /admin says "not set up".

# Neon Postgres connection string. Added automatically when you connect Neon to the Vercel project.
DATABASE_URL=

# Vercel Blob read-write token for uploaded images. Added automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=

# The password you type on /admin. Pick a long one.
ADMIN_PASSWORD=

# Signs the login cookie. At least 32 characters or the admin treats itself as not set up.
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=
