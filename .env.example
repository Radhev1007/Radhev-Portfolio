# Portfolio (Next.js) build-time settings — copy to .env.local for local overrides. Never put secrets here:
# NEXT_PUBLIC_* values are compiled into the public site.

# WebSocket URL of the RC Crawler multiplayer server (multiplayer-server/). Production must be wss://.
# Leave unset locally: the game finds a dev server on ws://localhost:2567 by itself.
NEXT_PUBLIC_RC_MULTIPLAYER_URL=
