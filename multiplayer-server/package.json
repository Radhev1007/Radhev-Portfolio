{
  "name": "rc-crawler-multiplayer",
  "version": "1.0.0",
  "private": true,
  "description": "Authoritative rooms, lobby state and voice tokens for RC Crawler online multiplayer (Colyseus + LiveKit).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "vendor": "node scripts/vendor-client.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "bots": "node scripts/bots.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "express": "^5.3.0",
    "livekit-server-sdk": "^2.19.1"
  },
  "devDependencies": {
    "colyseus.js": "^0.16.22",
    "livekit-client": "^2.22.4"
  }
}
