# RC Crawler multiplayer server — copy to .env (never commit .env) and fill in.

# Port the WebSocket + HTTP server listens on (most hosts set PORT for you).
PORT=2567
HOST=0.0.0.0

# Page origins allowed to join, comma-separated. Leave empty to allow any origin (fine for local dev).
# Production example: ALLOWED_ORIGINS=https://your-portfolio.example
ALLOWED_ORIGINS=

# Players per room, host included (2-20).
MAX_PLAYERS=20

# Seconds a dropped player's seat is held for them to reconnect.
RECONNECT_SECONDS=30

# Voice chat (optional). Without these, multiplayer works and the game says voice is not configured.
# LiveKit Cloud: wss://<project>.livekit.cloud plus an API key/secret from the project settings.
# Self-hosted dev server (`livekit-server --dev`): ws://localhost:7880, key devkey, secret secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lifetime of each voice token (a token is only needed to join; the call itself continues past it).
LIVEKIT_TOKEN_TTL=15m
